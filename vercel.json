{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php"
    },
    {
      "source": "/admin",
      "destination": "/api/index.php"
    },
    {
      "source": "/cashier",
      "destination": "/api/index.php"
    },
    {
      "source": "/(.*\\.php)",
      "destination": "/api/index.php"
    }
  ]
}
