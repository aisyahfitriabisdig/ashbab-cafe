# Salin dan isi nilai ini di Vercel -> Project Settings -> Environment Variables

# Pilihan 1: Gunakan Connection String dari Supabase (Transaction Pooler, Port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Pilihan 2 (opsional jika tidak pakai DATABASE_URL):
# DB_DRIVER=pgsql
# DB_HOST=aws-0-[REGION].pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.[PROJECT-REF]
# DB_PASS=[PASSWORD]

# URL aplikasi Vercel Anda (tanpa garis miring di akhir)
APP_URL=https://nama-project-anda.vercel.app

# Supabase Storage (untuk upload gambar menu & pengaturan di Vercel)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_BUCKET=uploads

